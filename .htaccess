# neliaudio.com — sitio estático en Hostinger (LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------- siempre HTTPS y sin www (el audio y el micrófono del navegador exigen HTTPS) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://neliaudio.com%{REQUEST_URI} [L,R=301]
  # /meowdacity → /meowdacity/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# ---------- tipos ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------- compresión ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json text/xml application/xml text/plain
</IfModule>

# ---------- caché: el HTML siempre fresco; fuentes e imágenes, un año ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # ---------- seguridad (sin romper el motor de audio, que carga su código como blob: o data:) ----------
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
</IfModule>

# archivos internos de Git: no se sirven
RedirectMatch 404 /\.git
